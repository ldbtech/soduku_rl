            "enabled": true
        },
        {
            "name": "unique_columns",
            "type": "unique",
            "scope": "column",
            "ignore": 0,
            "enabled": true
        },
        {
            "name": "unique_subgrids",
            "type": "unique",
            "scope": "subgrid",
            "ignore": 0,
            "enabled": true
        }
    ]
}

