# Leave empty to use the built-in mock backend (default).
# Set to your API base URL to use the real backend instead.
VITE_API_URL=

# Force the mock backend even when VITE_API_URL is set. Defaults to true
# when VITE_API_URL is empty.
VITE_USE_MOCK=true

# Simulated network latency (ms) applied by the mock backend.
VITE_MOCK_LATENCY_MS=350

# Placeholder policy the mock backend plays with: "random" clicks a random
# empty cell with a random digit, "solver" plays correct digits. The real RL
# policy will arrive as the HTTP backend. Defaults to "random".
VITE_AGENT_MODE=random
